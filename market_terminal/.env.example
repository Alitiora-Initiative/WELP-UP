# Copy to .env in the repository root or run folder. All provider credentials are optional.
# No private wallet keys, exchange signing secrets, or live-broker credentials are used.

# Persistent SQLite directory (defaults to ~/.welp-market-terminal)
# WELP_MARKET_DATA_DIR=C:/Users/you/.welp-market-terminal

# Global market watchlist: real US shares / ETF symbols and OKX spot pairs
WELP_MARKET_WATCHLIST=AAPL,MSFT,NVDA,SPY,BTC-USDT,ETH-USDT,SOL-USDT

# Local internal paper portfolio — default $10 and $6 untouched cash reserve
WELP_PAPER_EQUITY=10
WELP_PAPER_RESERVE=6
WELP_PAPER_MAX_EXPOSURE=4
WELP_PAPER_MAX_POSITION=2
WELP_PAPER_MAX_POSITIONS=2
WELP_PAPER_RISK_PER_TRADE=0.05
WELP_PAPER_STOP_PCT=0.025
WELP_PAPER_TAKE_PROFIT_PCT=0.05
WELP_PAPER_MAX_DRAWDOWN=0.20
WELP_PAPER_MAX_TRADES_DAY=2
WELP_PAPER_MAX_TRADES_WEEK=6
WELP_AUTO_PAPER=false

# Optional paid/licensed news provider. Otherwise use GDELT public news discovery.
# MARKETAUX_API_TOKEN=

# Optional Reddit OAuth app. Reddit use is disabled until you provide approved API access.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=WELP-UP-market-terminal/0.1 by <your-reddit-username>

# Yahoo Finance research uses yfinance; this adapter is unofficial/personal research and can be delayed.
# Do not redistribute Yahoo data commercially without appropriate rights.
