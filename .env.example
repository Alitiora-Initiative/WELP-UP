# WELP UP! environment template.
# The browser app never asks for a private key, seed phrase, or secret key.
# Never paste a wallet secret into this file, chat, or any website form.

# --- Browser / Next.js (optional) ---
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=                 # server-side only; never prefix with NEXT_PUBLIC_

# --- Optional agent tuning (CLI operator path only) ---
# WELP_MIN_TRADE_SOL=0.001
# WELP_MIN_ACCOUNT_USD=0.50
