# WELP UP! optional environment template.
# Swaps are signed only by the wallet connected on the website.
# Keep provider credentials server-side. No vault program ID is configured.

# --- Browser / Next.js (optional) ---
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=

# --- Webacy security intelligence (server-only; never use NEXT_PUBLIC_ prefix) ---
# Required to enable the Webacy risk dashboard and /api/webacy proxy.
# Configure this as a Sensitive environment variable in Vercel.
# WEBACY_API_KEY=

# --- Pump.fun token creation metadata (server-only) ---
# Required for the Launch Studio Pump.fun route; create a Pinata API key with public IPFS upload permission.
# PINATA_JWT=

# --- Optional scanner tuning --- 
# WELP_MIN_TRADE_SOL=0.001
# WELP_MIN_ACCOUNT_USD=0.50
# WELP_MAX_TRADE_SOL=0.02
# WELP_MAX_POSITIONS=2
# WELP_LOOP_SECONDS=45
# WELP_FEE_RESERVE_SOL=0.003
# WELP_PRIORITY_FEE_LAMPORTS=0
# WELP_DATA_DIR=./data

# --- WELP protocol fee collection via Jupiter referral --- 
# Create a Jupiter referral account once, then set the public key here.
# WELP_REFERRAL_ACCOUNT=
# WELP_REFERRAL_FEE_BPS=50
