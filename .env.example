# WELP UP! optional environment template.
# Swaps are signed only by the wallet connected on the website.
# Keep provider credentials server-side. No vault program ID is configured.

# --- Browser / Next.js (optional) ---
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=  # Optional for keyless Jupiter Swap API v2 access; server-side only (higher rate tier).

# --- Optional scanner tuning --- 
# WELP_MIN_TRADE_SOL=0.001
# WELP_MIN_ACCOUNT_USD=0.50
# WELP_MAX_TRADE_SOL=0.02
# WELP_MAX_POSITIONS=2
# WELP_LOOP_SECONDS=45
# WELP_FEE_RESERVE_SOL=0.003
# WELP_PRIORITY_FEE_LAMPORTS=0
# WELP_DATA_DIR=./data

# --- WELP swap fee collection via Jupiter referral ---
# Referral account exists on mainnet; set only after its fee-mint token account is initialized.
# This route collects to the referral partner, not the WELP treasury PDA.
# WELP_REFERRAL_ACCOUNT=2puMMFLeeVYPifiJGeNefnYiGFpXSDNTDSAMiq9ndUuV
# WELP_REFERRAL_FEE_BPS=50
