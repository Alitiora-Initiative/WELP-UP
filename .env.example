# WELP UP! reads the environment only. Never commit a filled-in .env.
# Use a dedicated wallet. Real swaps. Losses come out of this account.

# Browser frontend (all optional)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=                 # server-side only; do not prefix with NEXT_PUBLIC_

# Legacy Python command-line runner only. The browser frontend never reads this.

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key, or a JSON array of 64 bytes. Not a seed phrase.
SOLANA_PRIVATE_KEY=

# Must be exactly this value or the process will not send transactions.
WELP_ARM=TRADE-LIVE

# Optional. Keyless Jupiter is severely rate-limited.
JUPITER_API_KEY=

# Optional tightening. Floors are hard: trade cannot go below 0.001 SOL,
# account cannot go below 0.50 USD. Higher values are allowed.
# WELP_MIN_TRADE_SOL=0.001
# WELP_MIN_ACCOUNT_USD=0.50
# WELP_MAX_TRADE_SOL=0.02
# WELP_MAX_POSITIONS=2
# WELP_LOOP_SECONDS=45
# WELP_FEE_RESERVE_SOL=0.003
# WELP_PRIORITY_FEE_LAMPORTS=0
# WELP_DATA_DIR=./data
