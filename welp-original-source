import { useCallback, useEffect, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { ArrowRight, Loader2, RefreshCw, Wallet, TrendingUp, TrendingDown } from 'lucide-react';
import VaultChart from '@/components/VaultChart';
import TokenLogo from '@/components/TokenLogo';
import { useWallet } from '@/lib/wallet';
import { SOL_MINT, fetchPrices } from '@/lib/jupiter';
import { getSolBalance, getTokenAccounts } from '@/lib/rpc';
import { fmtSol, fmtUsd, shortAddr, fmtPct, clockTime } from '@/lib/format';

// Dashboard vault + asset tracking panel. Reads the connected wallet's
// mainnet balances live and plots the per-wallet vault cap chart. Shown on
// the home dashboard so the operator can watch real-time performance and
// total holdings without leaving the console.
export default function DashboardVaultPanel({ marketTokens = [] }) {
  const { address, connect, connecting, installed } = useWallet();
  const [balance, setBalance] = useState(null);
  const [holdings, setHoldings] = useState([]);
  const [solPrice, setSolPrice] = useState(0);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [refreshedAt, setRefreshedAt] = useState(null);

  const tokenByMint = useMemo(() => {
    const map = new Map();
    marketTokens.forEach((t) => map.set(t.id, t));
    return map;
  }, [marketTokens]);

  const load = useCallback(async () => {
    if (!address) return;
    setLoading(true);
    setError(null);
    try {
      const [solBalance, accounts, prices] = await Promise.all([
        getSolBalance(address),
        getTokenAccounts(address),
        fetchPrices([SOL_MINT]),
      ]);
      const solUsd = prices[SOL_MINT] || 0;
      const priced = await fetchPrices(accounts.map((a) => a.mint).slice(0, 40)).catch(() => ({}));
      setSolPrice(solUsd);
      setBalance(solBalance);
      setHoldings(
        accounts
          .map((account) => {
            const meta = tokenByMint.get(account.mint);
            const price = meta?.price || priced[account.mint] || 0;
            return {
              ...account,
              symbol: meta?.symbol || account.mint.slice(0, 4).toUpperCase(),
              icon: meta?.icon || null,
              price,
              value: price * account.amount,
              change24h: meta?.change24h ?? 0,
            };
          })
          .sort((a, b) => b.value - a.value)
          .slice(0, 8)
      );
      setRefreshedAt(new Date());
    } catch (err) {
      setError(err?.message || 'Could not read this wallet from mainnet.');
    } finally {
      setLoading(false);
    }
  }, [address, tokenByMint]);

  useEffect(() => {
    load();
    const timer = setInterval(load, 30000);
    return () => clearInterval(timer);
  }, [load]);

  const solValue = (balance || 0) * solPrice;
  const tokenValue = useMemo(() => holdings.reduce((sum, h) => sum + h.value, 0), [holdings]);
  const totalValue = solValue + tokenValue;

  // weighted 24h performance across priced holdings + SOL
  const performance = useMemo(() => {
    const rows = [];
    if (balance && solPrice) {
      const solMeta = tokenByMint.get(SOL_MINT);
      rows.push({ value: solValue, change: solMeta?.change24h ?? 0 });
    }
    holdings.forEach((h) => {
      if (h.value > 0) rows.push({ value: h.value, change: h.change24h });
    });
    const totalWeight = rows.reduce((s, r) => s + r.value, 0);
    if (!totalWeight) return 0;
    return rows.reduce((s, r) => s + r.value * r.change, 0) / totalWeight;
  }, [balance, solValue, holdings, tokenByMint]);

  const perfUp = performance >= 0;

  if (!address) {
    return (
      <section className="border-b border-border py-12">
        <div className="panel relative overflow-hidden p-6 sm:p-8">
          <div className="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
            <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-border">
              <Wallet className="h-5 w-5 text-muted-foreground" />
            </span>
            <div className="flex-1">
              <p className="micro">Vault & holdings · per wallet</p>
              <h2 className="mt-1 font-heading text-[20px] font-medium">Connect a wallet to see your vault chart and total holdings</h2>
              <p className="mt-1.5 text-[12px] leading-relaxed text-muted-foreground">
                Your acknowledged vault cap plots here, plus a live read of SOL and token balances from mainnet.
              </p>
            </div>
            <button
              type="button"
              onClick={connect}
              disabled={connecting || !installed}
              className="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-[13px] font-semibold text-primary-foreground disabled:opacity-60"
            >
              {connecting ? <Loader2 className="h-4 w-4 animate-spin" /> : <Wallet className="h-4 w-4" />}
              Connect wallet
            </button>
          </div>
          {!installed && (
            <p className="mt-3 text-center font-mono text-[10px] text-muted-foreground">
              No Solana wallet detected — install Phantom or Solflare to open a session.
            </p>
          )}
        </div>
      </section>
    );
  }

  return (
    <section className="border-b border-border py-12">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="micro">Vault & holdings · per wallet</p>
          <h2 className="mt-2 font-heading text-[clamp(1.6rem,3vw,2.2rem)] font-semibold tracking-tight">
            Real-time performance for {shortAddr(address, 6, 4)}
          </h2>
        </div>
        <button
          type="button"
          onClick={load}
          className="inline-flex items-center gap-2 rounded-full border border-border px-4 py-1.5 text-[12px] transition hover:border-signal/60 hover:text-signal"
        >
          <RefreshCw className={`h-3.5 w-3.5 ${loading ? 'animate-spin' : ''}`} /> Refresh
        </button>
      </div>

      {error && (
        <p className="mt-4 rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-[12px] text-destructive">{error}</p>
      )}

      <div className="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { label: 'Total holdings', value: balance !== null ? fmtUsd(totalValue) : '—', hint: 'SOL + priced tokens' },
          { label: 'SOL balance', value: balance === null ? '—' : fmtSol(balance, 4), hint: solPrice ? `${fmtUsd(solPrice)} / SOL` : ' ' },
          { label: 'Token holdings', value: String(holdings.length), hint: holdings.length ? 'priced accounts' : ' ' },
          {
            label: '24h performance',
            value: balance !== null ? fmtPct(performance, 2) : '—',
            hint: 'weighted by holdings value',
          },
        ].map((stat) => (
          <div key={stat.label} className="panel p-4">
            <p className="micro !text-[9px]">{stat.label}</p>
            <p
              className={`num mt-2 text-[18px] ${
                stat.label === '24h performance' ? (perfUp ? 'text-up' : 'text-down') : ''
              }`}
            >
              {stat.label === '24h performance' && balance !== null ? (
                <span className="inline-flex items-center gap-1">
                  {perfUp ? <TrendingUp className="h-4 w-4" /> : <TrendingDown className="h-4 w-4" />}
                  {stat.value}
                </span>
              ) : (
                stat.value
              )}
            </p>
            <p className="mt-1 text-[10px] leading-snug text-muted-foreground">{stat.hint}</p>
          </div>
        ))}
      </div>

      <div className="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]">
        <div className="panel overflow-hidden">
          <div className="flex items-center justify-between border-b border-border px-5 py-4">
            <p className="micro">Asset tracking · top holdings</p>
            <span className="font-mono text-[10px] text-muted-foreground">
              {refreshedAt ? `Updated ${clockTime(refreshedAt)}` : '—'} · auto-refresh 30s
            </span>
          </div>
          {loading && !holdings.length ? (
            <div className="space-y-2 p-5">
              {Array.from({ length: 5 }).map((_, i) => (
                <div key={i} className="h-10 animate-pulse rounded-md bg-secondary/60" />
              ))}
            </div>
          ) : holdings.length ? (
            <table className="w-full min-w-[420px] text-left">
              <thead>
                <tr className="border-b border-border/70">
                  <th className="micro px-5 py-2.5 font-normal">Asset</th>
                  <th className="micro px-5 py-2.5 text-right font-normal">Balance</th>
                  <th className="micro px-5 py-2.5 text-right font-normal">Value</th>
                  <th className="micro px-5 py-2.5 text-right font-normal">24h</th>
                </tr>
              </thead>
              <tbody>
                <tr className="hover-row border-b border-border/40">
                  <td className="px-5 py-3">
                    <span className="flex items-center gap-2.5">
                      <span className="flex h-6 w-6 items-center justify-center rounded-full border border-border font-mono text-[9px] text-signal">SOL</span>
                      <span className="text-[12px]">Solana</span>
                    </span>
                  </td>
                  <td className="num px-5 py-3 text-right text-[11px]">{balance === null ? '—' : fmtSol(balance, 4)}</td>
                  <td className="num px-5 py-3 text-right text-[11px]">{solPrice ? fmtUsd(solValue) : '—'}</td>
                  <td className="num px-5 py-3 text-right text-[11px]">
                    <span className={tokenByMint.get(SOL_MINT)?.change24h >= 0 ? 'text-up' : 'text-down'}>
                      {fmtPct(tokenByMint.get(SOL_MINT)?.change24h ?? 0, 2)}
                    </span>
                  </td>
                </tr>
                {holdings.map((h) => (
                  <tr key={h.mint} className="hover-row border-b border-border/40 last:border-0">
                    <td className="px-5 py-3">
                      <span className="flex min-w-0 items-center gap-2.5">
                        <TokenLogo token={{ symbol: h.symbol, icon: h.icon }} size={24} />
                        <span className="min-w-0">
                          <span className="block truncate text-[12px]">{h.symbol}</span>
