    ink: '#f5f4ec',
    cap: '#d4fb5f',
    capInk: '#0b0b07',
  },
  {
    id: 'eligible',
    label: 'Eligible',
    color: 'var(--dt1-shipped)',
    fill: 'var(--dt1-shipped-grad)',
    ink: 'var(--dt1-shipped-ink)',
  },
  {
    id: 'blocked',
    label: 'Blocked',
    color: 'var(--dt1-cancelled)',
    fill: 'var(--dt1-cancelled-grad)',
    ink: 'var(--dt1-cancelled-badge-ink)',
  },
  {
    id: 'top',
    label: 'Score 90+',
    color: '#6be7c0',
    fill: 'linear-gradient(180deg, #6be7c0 0%, #b6f5e3 100%)',
    ink: '#08120f',
  },
  {
    id: 'verified',
    label: 'Verified',
    color: 'var(--dt1-refunded)',
    fill: 'var(--dt1-refunded-grad)',
    ink: 'var(--dt1-refunded-badge-ink)',
  },
];

const LIFECYCLE = { eligible: 0, watch: 1, blocked: 2 };

function stateOf(evaluation) {
  if (!evaluation.eligible) return 'blocked';
  if (evaluation.warnings.length) return 'watch';
  return 'eligible';
}

function downloadCsv(rows) {
  const header = ['Asset', 'Mint', 'Price', 'Change24h', 'Liquidity', 'Volume24h', 'Organic', 'Score', 'State'];
  const body = rows.map((row) =>
    [
      row.token.symbol,
      row.token.id,
      row.token.price,
      row.token.change24h.toFixed(4),
      Math.round(row.token.liquidity),
      Math.round(row.token.volume24h),
      row.token.organicScore.toFixed(2),
      row.score,
      stateOf(row),
    ].join(',')
  );
  const csv = [header.join(','), ...body].join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `welp-markets-${new Date().toISOString().slice(0, 10)}.csv`;
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
}

export default function MarketDataTable({ evaluations = [], status = 'loading', updatedAt = null, query = '' }) {
  const [filter, setFilter] = useState('all');
  const [sort, setSort] = useState({ key: 'score', dir: 'desc' });
  const [page, setPage] = useState(1);
  const [selected, setSelected] = useState([]);
  const [toast, setToast] = useState('');
  const [entering, setEntering] = useState(true);
  const toastTimer = useRef(null);
  const wrapRef = useRef(null);
  const markerRef = useRef(null);

  useEffect(() => {
    const timer = setTimeout(() => setEntering(false), 1200);
    return () => clearTimeout(timer);
  }, []);

  useEffect(() => () => clearTimeout(toastTimer.current), []);

  const counts = useMemo(() => {
    const result = { all: evaluations.length, eligible: 0, blocked: 0, top: 0, verified: 0 };
    evaluations.forEach((evaluation) => {
      if (evaluation.eligible) result.eligible += 1;
      else result.blocked += 1;
      if (evaluation.score >= 90) result.top += 1;
      if (evaluation.token.verified) result.verified += 1;
    });
    return result;
  }, [evaluations]);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    return evaluations.filter((evaluation) => {
      if (filter === 'verified' && !evaluation.token.verified) return false;
      if (filter === 'eligible' && !evaluation.eligible) return false;
      if (filter === 'blocked' && evaluation.eligible) return false;
      if (filter === 'top' && evaluation.score < 90) return false;
      if (q) {
        const hay = `${evaluation.token.symbol} ${evaluation.token.name} ${evaluation.token.id}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
  }, [evaluations, filter, query]);

  const sorted = useMemo(() => {
    const list = [...filtered];
    const dir = sort.dir === 'asc' ? 1 : -1;
    list.sort((a, b) => {
      if (sort.key === 'asset') return a.token.symbol.localeCompare(b.token.symbol) * dir;
      if (sort.key === 'state') return (LIFECYCLE[stateOf(a)] - LIFECYCLE[stateOf(b)]) * dir;
      if (sort.key === 'organic') return (a.token.organicScore - b.token.organicScore) * dir;
      if (sort.key === 'price') return (a.token.price - b.token.price) * dir;
      if (sort.key === 'change') return (a.token.change24h - b.token.change24h) * dir;
      if (sort.key === 'liquidity') return (a.token.liquidity - b.token.liquidity) * dir;
      if (sort.key === 'volume') return (a.token.volume24h - b.token.volume24h) * dir;
      return (a.score - b.score) * dir;
