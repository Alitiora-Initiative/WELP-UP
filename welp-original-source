export const LIMITS = {
  buyDefaultSol: 0.001,
  buyMinSol: 0.001,
  buyMaxSol: 0.02,
  minWalletEquityUsd: 0.5,
  feeReserveSol: 0.003,
  maxPriceImpactPct: 2.5,
  quoteFreshnessSeconds: 45,
  scoreMin: 80,
  scoreMax: 98,
  hardMinLiquidityUsd: 100_000,
  hardMinVolume24hUsd: 100_000,
  hardMaxTopHoldersPct: 60,
  warnMinLiquidityUsd: 250_000,
  warnMinHolders: 1_000,
  warnMaxTopHoldersPct: 40,
  warnMaxDrawdown24h: -25,
};

const clamp = (n, min, max) => Math.min(max, Math.max(min, n));
const logScale = (value, floor, ceiling) => {
  if (value <= floor) return 0;
  if (value >= ceiling) return 1;
  return (Math.log10(value) - Math.log10(floor)) / (Math.log10(ceiling) - Math.log10(floor));
};

function qualityOf(token) {
  const organic = clamp(token.organicScore / 100, 0, 1);
  const depth = logScale(token.liquidity, 100_000, 25_000_000);
  const turnover = clamp(token.volume24h / Math.max(token.mcap, 1) / 1.5, 0, 1);
  const holders = logScale(token.holders, 500, 150_000);
  const buyPressure = clamp(
    token.buys24h + token.sells24h > 0 ? token.buys24h / (token.buys24h + token.sells24h) : 0.5,
    0,
    1
  );
  const momentum = clamp(1 - Math.abs(token.change1h) / 14, 0, 1);

  const score =
    organic * 0.32 +
    depth * 0.2 +
    turnover * 0.15 +
    holders * 0.13 +
    buyPressure * 0.12 +
    momentum * 0.08;

  return clamp(score, 0, 1);
}

export function evaluateToken(token) {
  if (!token) return null;
  const blockers = [];
  const warnings = [];

  if (token.freezeAuthorityLive) {
    blockers.push({ id: 'freeze', label: 'Freeze authority live', detail: 'Issuer can freeze your token account' });
  }
  if (token.liquidity < LIMITS.hardMinLiquidityUsd) {
    blockers.push({
      id: 'liquidity',
      label: 'Thin liquidity',
      detail: `$${Math.round(token.liquidity).toLocaleString()} across pools (floor $100,000)`,
    });
  }
  if (token.volume24h < LIMITS.hardMinVolume24hUsd) {
    blockers.push({
      id: 'volume',
      label: 'Low traded volume',
      detail: `$${Math.round(token.volume24h).toLocaleString()} in 24h (floor $100,000)`,
    });
  }
  if (token.topHoldersPct > LIMITS.hardMaxTopHoldersPct) {
    blockers.push({
      id: 'concentration',
      label: 'Holder concentration',
      detail: `Top holders own ${token.topHoldersPct.toFixed(1)}% (max 60%)`,
    });
  }
  if (token.change24h < LIMITS.warnMaxDrawdown24h) {
    warnings.push({
      id: 'drawdown',
      label: 'Sharp 24h drawdown',
      detail: `${token.change24h.toFixed(1)}% over 24h`,
    });
  }

  if (token.mintAuthorityLive) {
    warnings.push({ id: 'mint', label: 'Mint authority live', detail: 'Supply can still be expanded' });
  }
  if (token.liquidity < LIMITS.warnMinLiquidityUsd) {
    warnings.push({
      id: 'depth',
      label: 'Depth below desk floor',
      detail: 'Under $250,000 — size and exits are constrained',
    });
  }
  if (token.holders > 0 && token.holders < LIMITS.warnMinHolders) {
    warnings.push({ id: 'holders', label: 'Small holder base', detail: `${token.holders} holders` });
  }
  if (token.topHoldersPct > LIMITS.warnMaxTopHoldersPct && token.topHoldersPct <= LIMITS.hardMaxTopHoldersPct) {
    warnings.push({
      id: 'concentration-warn',
      label: 'Top-heavy supply',
      detail: `Top holders own ${token.topHoldersPct.toFixed(1)}%`,
    });
  }
  if (token.organicScore < 60) {
    warnings.push({ id: 'organic', label: 'Low organic score', detail: `${token.organicScore.toFixed(0)}/100` });
  }

  const quality = qualityOf(token);
  const score = Math.round(LIMITS.scoreMin + (LIMITS.scoreMax - LIMITS.scoreMin) * quality);
  const eligible = blockers.length === 0;

  return {
    token,
    score: clamp(score, LIMITS.scoreMin, LIMITS.scoreMax),
    quality,
    eligible,
    verdict: eligible ? 'eligible' : 'blocked',
    blockers,
    warnings,
    band: `${LIMITS.scoreMin}–${LIMITS.scoreMax}`,
  };
}

export function rankTokens(tokens) {
  return (tokens || [])
    .map(evaluateToken)
    .filter(Boolean)
    .sort((a, b) => {
      if (a.eligible !== b.eligible) return a.eligible ? -1 : 1;
      return b.score - a.score;
  
