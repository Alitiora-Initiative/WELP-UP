import { getSolBalance } from '@/lib/rpc';
import { recordTrade, tradeFeeUsd } from '@/lib/ledger';
import { fmtPct, fmtSol, fmtUsd, shortAddr } from '@/lib/format';

const DEFAULT_BUY = {
  id: USDC_MINT,
  symbol: 'USDC',
  name: 'USD Coin',
  decimals: 6,
  price: 1,
  verified: true,
  change24h: 0,
  liquidity: 0,
  organicScore: 0,
};

const QUICK_AMOUNTS = [0.001, 0.005, 0.01, 0.02];

export default function Swap() {
  const { address, connect } = useWallet();
  const { tokens } = useMarketTokens({ limit: 100 });
  const [buyToken, setBuyToken] = useState(DEFAULT_BUY);
  const [search, setSearch] = useState('');
  const [results, setResults] = useState([]);
  const [searching, setSearching] = useState(false);
  const [amount, setAmount] = useState('0.001');
  const [quote, setQuote] = useState(null);
  const [quoting, setQuoting] = useState(false);
  const [quoteError, setQuoteError] = useState(null);
  const [quotedAt, setQuotedAt] = useState(null);
  const [balance, setBalance] = useState(null);
  const [solPrice, setSolPrice] = useState(0);
  const [copied, setCopied] = useState(false);
  const [tick, setTick] = useState(0);
  const initialised = useRef(false);

  useEffect(() => {
    const timer = setInterval(() => setTick((t) => t + 1), 1000);
    return () => clearInterval(timer);
  }, []);

  useEffect(() => {
    fetchPrices([SOL_MINT, USDC_MINT]).then((prices) => {
      setSolPrice(prices[SOL_MINT] || 0);
      const usdc = prices[USDC_MINT];
      if (usdc) setBuyToken((prev) => (prev.id === USDC_MINT ? { ...prev, price: usdc } : prev));
    });
  }, []);

  useEffect(() => {
    if (!address) {
      setBalance(null);
      return;
    }
    let alive = true;
    getSolBalance(address)
      .then((value) => alive && setBalance(value))
      .catch(() => alive && setBalance(null));
    return () => {
      alive = false;
    };
  }, [address]);

  useEffect(() => {
    if (!search.trim() || search.trim().length < 2) {
      setResults([]);
      return;
    }
    setSearching(true);
    const timer = setTimeout(() => {
      searchTokens(search)
        .then((list) => setResults(list.slice(0, 6)))
        .catch(() => setResults([]))
        .finally(() => setSearching(false));
    }, 320);
    return () => clearTimeout(timer);
  }, [search]);

  // Deep link from the market board: /swap?buy=<mint>
  useEffect(() => {
    if (initialised.current) return;
    const params = new URLSearchParams(window.location.search);
    const mint = params.get('buy');
    if (!mint || mint === USDC_MINT) {
      initialised.current = true;
      return;
    }
    const fromFeed = tokens.find((t) => t.id === mint);
    if (fromFeed) {
      setBuyToken(fromFeed);
      initialised.current = true;
      return;
    }
    searchTokens(mint)
      .then((list) => {
        const match = list.find((t) => t.id === mint);
        if (match) setBuyToken(match);
      })
      .catch(() => {})
      .finally(() => {
        initialised.current = true;
      });
  }, [tokens]);

  const amountNumber = Number(amount);
  const lamports = Math.round((Number.isFinite(amountNumber) ? amountNumber : 0) * 1e9);
  const solEquity = balance === null ? null : balance * solPrice;

  const checks = useMemo(() => {
    const amountOk = amountNumber >= LIMITS.buyMinSol && amountNumber <= LIMITS.buyMaxSol;
    const impact = quote ? Number(quote.priceImpactPct) * 100 : 0;
    const impactOk = quote ? impact <= LIMITS.maxPriceImpactPct : false;
    const reserveOk = balance === null ? false : balance >= amountNumber + LIMITS.feeReserveSol;
    const equityOk = solEquity === null ? false : solEquity >= LIMITS.minWalletEquityUsd;
    return [
      {
        id: 'wallet',
        label: 'Wallet session active',
        pass: Boolean(address),
        detail: address ? `Signing wallet ${shortAddr(address, 5, 5)}` : 'Connect a Solana wallet to continue',
      },
      {
        id: 'amount',
        label: `Amount inside ${LIMITS.buyMinSol}–${LIMITS.buyMaxSol} SOL`,
        pass: amountOk,
        detail: amountOk ? `${amountNumber} SOL` : 'Outside the enforced range',
      },
      {
        id: 'equity',
        label: `Wallet equity at least $${LIMITS.minWalletEquityUsd.toFixed(2)}`,
        pass: equityOk,
        detail:
          solEquity === null
            ? 'Connect a wallet to read equity'
            : `Live SOL equity ≈ ${fmtUsd(solEquity)}`,
      },
      {
        id: 'reserve',
        label: `${LIMITS.feeReserveSol} SOL kept for fees`,
        pass: reserveOk,
        detail: balance === null ? 'Balance unread' : `${fmtSol(balance, 4)} in wallet`,
      },
      {
        id: 'impact',
        label: `Price impact at or under ${LIMITS.maxPriceImpactPct}%`,
        pass: impactOk,
        detail: quote ? `${impact.toFixed(3)}% on this route` : 'Request a quote to measure',
      },
    ];
  }, [address, amountNumber, balance, quote, solEquity]);

  const blockers = checks.filter((check) => !check.pass);
  const ready = blockers.length === 0 && Boolean(quote);

