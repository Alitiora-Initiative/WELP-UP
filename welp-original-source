    setQuoting(true);
    setQuoteError(null);
    try {
      const result = await fetchQuote({
        inputMint: SOL_MINT,
        outputMint: buyToken.id,
        amount: lamports,
        slippageBps: 50,
      });
      setQuote(result);
      setQuotedAt(Date.now());
    } catch (error) {
      setQuote(null);
      setQuotedAt(null);
      setQuoteError(error?.message || 'No route available for this pair.');
    } finally {
      setQuoting(false);
    }
  }, [buyToken.id, lamports]);

