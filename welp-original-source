.dt1-bulk-n {
  font-size: 0.75rem;
  color: var(--dt1-ink-mid);
  padding-right: 4px;
}
.dt1-spacer { flex: 1 1 auto; }

/* ── table block ──────────────────────────────────────── */
.dt1-tablewrap {
  position: relative;
  margin: 0 var(--dt1-pad);
  padding: 0 0 6px;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 14px;
  background: var(--dt1-table-fill) padding-box, var(--dt1-table-edge) border-box;
}
.dt1-tablewrap::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  z-index: 3;
  box-shadow: inset 2px 0 4px 0 rgba(255, 255, 255, 0.05), inset 0 2px 4px 0 rgba(255, 255, 255, 0.05);
}
.dt1-zone { position: relative; }

.dt1-marker {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 0;
  border-radius: var(--dt1-row-radius);
  background: var(--dt1-row-hover);
  opacity: 0;
  pointer-events: none;
  z-index: 0;
  transition: translate 260ms cubic-bezier(0.22, 1, 0.36, 1), height 260ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.2s ease;
}
.dt1-marker[data-on='1'] { opacity: 1; border-radius: var(--dt1-row-radius-on); }

.dt1-table {
  display: table;
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  position: relative;
  z-index: 1;
  font-size: 0.8125rem;
}
.dt1-thead { display: table-header-group; }
.dt1-th {
  font-weight: 500;
  color: var(--dt1-ink-head);
  background-color: #1a1a15;
  text-align: left;
  white-space: nowrap;
  padding: 11px 14px;
  vertical-align: middle;
}
.dt1-th--pick, .dt1-cell--pick { width: 38px; padding-left: 16px; padding-right: 0; }
.dt1-tbody { display: table-row-group; }
.dt1-row { display: table-row; }
.dt1-rowline {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 0;
  height: 1px;
  border-radius: 1px;
  background: var(--dt1-row-line-grad);
  opacity: 0.35;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.3s ease;
  pointer-events: none;
  z-index: 1;
}
.dt1-row:hover .dt1-rowline { transform: scaleX(1); }
.dt1-row[data-sel='1'] { background: var(--dt1-row-hover); }
.dt1-cell {
  display: table-cell;
  vertical-align: middle;
  padding: 10px 14px;
  position: relative;
  border-bottom: 1px solid #161612;
}
.dt1-row:last-child .dt1-cell { border-bottom: 0; }
.dt1-cell--pick { position: relative; }
.dt1-th--total, .dt1-cell--total, .dt1-th--status, .dt1-cell--status { text-align: right; }

.dt1-sort {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  font-size: 0.625rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: color 0.14s ease;
}
.dt1-sort:hover { color: var(--dt1-ink); }
.dt1-sort-ind {
  width: 11px;
  height: 11px;
  fill: currentColor;
  opacity: 0;
  transition: opacity 0.14s ease, transform 0.18s ease;
}
.dt1-th[aria-sort] .dt1-sort-ind { opacity: 1; }
.dt1-th[aria-sort='ascending'] .dt1-sort-ind { transform: rotate(180deg); }
.dt1-th--total .dt1-sort, .dt1-th--status .dt1-sort { flex-direction: row-reverse; }

.dt1-asset { display: flex; align-items: center; gap: 10px; min-width: 0; }
.dt1-asset-name { font-size: 0.8125rem; color: var(--dt1-ink-mid); }
.dt1-asset-sub { font-size: 0.6875rem; color: var(--dt1-ink-dim); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dt1-avatar {
  flex: 0 0 auto;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-family: var(--font-mono);
  font-size: 0.5625rem;
  text-transform: uppercase;
  border: 1px solid var(--dt1-chip-line);
  background: var(--dt1-chip-fill);
  color: #b9e7d6;
  overflow: hidden;
}
.dt1-avatar-img { width: 100%; height: 100%; object-fit: cover; display: block; }

.dt1-num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 0.75rem; }
.dt1-dim { color: var(--dt1-ink-dim); }
.dt1-score { font-size: 0.8125rem; font-weight: 600; }
.dt1-score--hi { color: var(--dt1-shipped); }
.dt1-score--mid { color: var(--dt1-ink-mid); }
.dt1-score--lo { color: var(--dt1-ink-dim); }

.dt1-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  height: 24px;
  padding: 0 10px;
  font-family: var(--font-mono);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.dt1-badge--eligible { background: var(--dt1-shipped-grad); color: var(--dt1-shipped-ink); }
.dt1-badge--watch { background: var(--dt1-pending-grad); color: var(--dt1-pending-ink); }
.dt1-badge--blocked { background: var(--dt1-cancelled-grad); color: var(--dt1-cancelled-badge-ink); }

.dt1-check { display: inline-flex; align-items: center; cursor: pointer; }
.dt1-check-input {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
}
.dt1-check-box {
  width: 15px;
  height: 15px;
  border: 1.5px solid var(--dt1-check-line);
  border-radius: 5px;
  display: grid;
  place-items: center;
  position: relative;
  transition: border-color 0.14s ease;
}
.dt1-check-icon { width: 11px; height: 11px; fill: var(--dt1-check-line-on); opacity: 0; transition: opacity 0.12s ease; }
.dt1-check:hover .dt1-check-box { border-color: var(--dt1-check-line-on); }
.dt1-check-input:checked + .dt1-check-box { border-color: var(--dt1-check-line-on); }
.dt1-check-input:checked + .dt1-check-box .dt1-check-icon { opacity: 1; }

.dt1-section :focus-visible { outline: 2px solid var(--dt1-focus); outline-offset: 2px; border-radius: 4px; }

/* ── empty + skeleton ─────────────────────────────────── */
.dt1-empty {
  display: grid;
  place-items: center;
  gap: 8px;
  padding: 48px 20px;
  text-align: center;
}
.dt1-empty-ico {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--dt1-line);
  border-radius: 50%;
  color: var(--dt1-ink-dim);
  background: var(--dt1-hatch), #0d0d0a;
}
.dt1-empty-t { font-size: 0.875rem; font-weight: 600; color: var(--dt1-ink); }
.dt1-empty-p { margin: 0; max-width: 40ch; font-size: 0.75rem; line-height: 1.6; color: var(--dt1-ink-dim); }

.dt1-skel { display: grid; gap: 8px; padding: 12px 14px; }
.dt1-skel-row {
  height: 44px;
  border-radius: 10px;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.05) 40%, rgba(255,255,255,0) 80%),
    var(--dt1-hatch), #0f0f0c;
  background-size: 240% 100%, auto, auto;
  animation: dt1-shimmer 1.25s linear infinite;
}
@keyframes dt1-shimmer {
  from { background-position: 120% 0; }
  to { background-position: -120% 0; }
}

/* ── footer ───────────────────────────────────────────── */
.dt1-foot {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  column-gap: 10px;
  row-gap: 8px;
  padding: 16px var(--dt1-pad) 18px;
}
.dt1-range { grid-area: 1 / 1; font-size: 0.75rem; color: var(--dt1-ink-dim); }
.dt1-meter {
  grid-area: 2 / 1;
  width: min(100%, 200px);
  min-width: 64px;
  height: 5px;
  border-radius: 999px;
  overflow: hidden;
  background: var(--dt1-hatch), #1c1c17;
}
.dt1-meter-fill {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #d4fb5f, #8fbf3a);
  transition: width 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
}
.dt1-pager { grid-area: 1 / 2 / span 2 / 3; justify-self: end; display: flex; align-items: center; gap: 4px; }
.dt1-page {
  min-width: 30px;
  height: 30px;
  padding: 0 8px;
  display: inline-grid;
  place-items: center;
  border: 1px solid var(--dt1-chip-line);
  border-radius: 999px;
  background: linear-gradient(180deg, #171712 0%, #121210 100%);
  color: #d6d6ca;
  font: inherit;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.14s ease, filter 0.14s ease;
}
.dt1-page:hover:not(:disabled) { color: var(--dt1-ink); filter: brightness(1.25); }
.dt1-page[aria-current='page'] {
  border-color: #3a3a30;
  background: linear-gradient(0deg, #17170f 12.5%, #3f3f32 100.81%);
  color: var(--dt1-ink-title);
}
.dt1-page:disabled { opacity: 0.35; cursor: default; }
.dt1-page svg { width: 12px; height: 12px; }

/* ── toast ────────────────────────────────────────────── */
.dt1-toast {
  position: absolute;
  left: 50%;
  bottom: 12px;
  transform: translate(-50%, 10px);
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: calc(100% - 24px);
  padding: 8px 14px;
  border: 1px solid var(--dt1-line);
  border-radius: 999px;
  background: var(--dt1-control);
  box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.95);
  color: var(--dt1-ink);
  font-size: 0.6875rem;
  font-weight: 500;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(0.2, 0.8, 0.3, 1);
  z-index: 5;
}
.dt1-toast svg { width: 13px; height: 13px; color: var(--dt1-shipped); flex: 0 0 auto; }
.dt1-shell { position: relative; }
.dt1-shell[data-dt1-toast='on'] .dt1-toast { opacity: 1; transform: translate(-50%, 0); }

/* ── entrance ─────────────────────────────────────────── */
@keyframes dt1-in-card {
  from { opacity: 0; transform: translateY(8px) scale(0.99); }
  to { opacity: 1; transform: none; }
}
@keyframes dt1-in-up {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: none; }
}
@keyframes dt1-in-row {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: none; }
}
.dt1-section[data-dt1-enter] .dt1-card { animation: dt1-in-card 420ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.dt1-section[data-dt1-enter] .dt1-titles { animation: dt1-in-up 380ms cubic-bezier(0.22, 1, 0.36, 1) 60ms both; }
.dt1-section[data-dt1-enter] .dt1-export { animation: dt1-in-up 340ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both; }
.dt1-section[data-dt1-enter] .dt1-fcard {
  animation: dt1-in-up 340ms cubic-bezier(0.22, 1, 0.36, 1) calc(120ms + var(--dt1-i, 0) * 30ms) both;
}
.dt1-section[data-dt1-enter] .dt1-tablewrap { animation: dt1-in-up 400ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both; }
.dt1-section[data-dt1-enter] .dt1-row {
  animation: dt1-in-row 360ms cubic-bezier(0.22, 1, 0.36, 1) calc(240ms + var(--dt1-i, 0) * 28ms) both;
}
.dt1-section[data-dt1-enter] .dt1-foot { animation: dt1-in-up 360ms cubic-bezier(0.22, 1, 0.36, 1) 320ms both; }

@media (prefers-reduced-motion: reduce) {
  .dt1-section[data-dt1-enter] .dt1-card,
  .dt1-section[data-dt1-enter] .dt1-titles,
  .dt1-section[data-dt1-enter] .dt1-export,
  .dt1-section[data-dt1-enter] .dt1-fcard,
  .dt1-section[data-dt1-enter] .dt1-tablewrap,
  .dt1-section[data-dt1-enter] .dt1-row,
  .dt1-section[data-dt1-enter] .dt1-foot,
  .dt1-beam { animation: none; }
}

/* narrow: collapse low-priority columns */
@media (max-width: 900px) {
  .dt1-col-hide-md { display: none; }
}
@media (max-width: 640px) {
  .dt1-col-hide-sm { display: none; }
  .dt1-tablewrap { overflow-x: auto; }
  .dt1-table { min-width: 440px; }
  .dt1-th, .dt1-cell { padding: 10px 8px; }
  .dt1-th--pick, .dt1-cell--pick { width: 34px; padding-left: 12px; }
  .dt1-foot { grid-template-columns: 1fr; }
  .dt1-pager { grid-area: 3 / 1; justify-self: start; }
}
