import { useState } from 'react';
import { Star } from 'lucide-react';
import { useWallet } from '@/lib/wallet';
import { isWatched, toggleWatch } from '@/lib/watchlist';
import { recordWatchlist } from '@/lib/ledger';

export default function WatchToggle({ token, size = 16, className = '' }) {
  const { address } = useWallet();
  const [watched, setWatched] = useState(() => isWatched(address, token.id));

  const onClick = (event) => {
    event.preventDefault();
    event.stopPropagation();
    const added = toggleWatch(address, token);
    setWatched(added);
    recordWatchlist(address, { action: added ? 'add' : 'remove', symbol: token.symbol, tokenId: token.id });
  };

  return (
    <button
      type="button"
      onClick={onClick}
      aria-label={watched ? 'Remove from watchlist' : 'Add to watchlist'}
      aria-pressed={watched}
      className={`inline-flex items-center justify-center rounded-full p-1 transition hover:bg-secondary ${className}`}
    >
      <Star
        style={{ width: size, height: size }}
        className={watched ? 'fill-signal text-signal' : 'text-muted-foreground'}
      />
    </button>
  );
}
