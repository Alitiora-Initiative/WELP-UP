{
  "name": "welp-up",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:notifications": "node --experimental-strip-types --test tests/notifications.test.mjs",
    "test:vault-client": "node --experimental-strip-types --test tests/vault-client.test.mjs",
    "test:charts": "node --experimental-strip-types --test tests/chart-providers.test.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.mjs",
    "indexnow": "node --env-file=.env.local scripts/indexnow.mjs",
    "test:agent": "node --experimental-strip-types --test tests/agent.test.mjs",
    "test:program-gates": "node --experimental-strip-types --test tests/program-gates.test.mjs",
    "test:market-scoring": "node --experimental-strip-types --test tests/market-scoring.test.mjs",
    "test:fees": "node --experimental-strip-types --test tests/fee-policy.test.mjs tests/referral-readiness.test.mjs",
    "test:vercel-deploy-gate": "node --experimental-strip-types --test tests/vercel-ignore-build.test.mjs",
    "test:launchpad-config": "node --experimental-strip-types --test tests/launchpad-config.test.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:git-hooks": "node --experimental-strip-types --test tests/git-hooks.test.mjs"
  },
  "dependencies": {
    "@solana/kit": "8.5.0",
    "@solana/kit-plugin-rpc": "0.22.0",
    "@solana/kit-plugin-wallet": "0.22.0",
    "@solana/react": "8.5.0",
    "@streamflow/stream": "^13.4.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "16.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
